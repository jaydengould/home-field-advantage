# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Virtual environments
.venv/
venv/
env/

# Raw data — never commit downloaded data, keep the folders via .gitkeep
data/raw/**
!data/raw/
!data/raw/**/
!data/raw/**/.gitkeep

# Interim/processed artifacts (optional: comment out to version processed data)
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Results are committed: the paper cites these CSVs, and results/tables/pre_*/ are
# archived snapshots of superseded runs that no pipeline step can regenerate.

# Quarto render output
/_site/
*.html
*.pdf
/.quarto/

# Superpowers SDD scratch (task briefs, reports, review packages, progress ledger)
.superpowers/

# OS / editor junk
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Paper: publish source, bibliography and PDF; keep review tooling and drafts local
/paper/*
!/paper/hfa.qmd
!/paper/hfa.pdf
!/paper/references.bib
/docs/superpowers/specs/*phase8-paper*
/docs/superpowers/plans/*phase8-paper*
